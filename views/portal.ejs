<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>پیوند امن — پنل مراجع</title>
  <link rel="stylesheet" href="/assets/fonts/vazirmatn/vazirmatn.css">
  <link rel="stylesheet" href="/assets/fonts/plex-arabic/plex-arabic.css">
  <link rel="stylesheet" href="/assets/tokens.css">
  <link rel="stylesheet" href="/assets/components.css">
  <link rel="stylesheet" href="/assets/panel.css">
  <link rel="stylesheet" href="/assets/panel-skin.css">
  <link rel="stylesheet" href="/assets/panel-v2.css">
</head>
<body class="zdp-panel-blank">
<div class="zdp-panel zdp-panel-shell" dir="rtl">
  <header class="zdp-shell-topbar">
    <div class="zdp-shell-brand">
      <span class="zdp-shell-brand-mark" aria-hidden="true">
        <span class="zdp-ring zdp-ring-a"></span>
        <span class="zdp-ring zdp-ring-b"></span>
      </span>
      <span class="zdp-shell-brand-name">پیوند امن</span>
    </div>
    <div class="zdp-topbar-actions">
      <button type="button" class="pui-theme-toggle" data-pui-theme-toggle aria-label="تغییر تم روشن یا تیره">حالت تیره</button>
      <a href="/dashboard" class="zdp-logout">داشبورد درمانگر</a>
      <% if (loggedIn) { %>
        <div class="zdp-shell-user">
          <span class="zdp-shell-user-avatar" aria-hidden="true">م</span>
          <span class="zdp-shell-user-info">
            <strong class="zdp-shell-user-name"><%= clientName %></strong>
            <span class="zdp-shell-user-mobile" dir="ltr"><%= clientMobile %></span>
          </span>
          <a href="/portal/logout" class="zdp-logout">
            <span class="zdp-shell-logout-label">خروج</span>
          </a>
        </div>
      <% } %>
    </div>
  </header>

  <% if (!loggedIn) { %>
    <div class="zdp-shell-main zdp-login-wrap">
      <section class="zdp-tab-panel">
        <h2 class="zdp-portal-heading">ورود به پنل مراجع</h2>
        <p class="zdp-portal-lead">نوبت‌ها، آزمون‌ها و پیام‌های شما در یک جای امن و خصوصی.</p>
        <form method="post" action="/portal/login">
          <div class="zdp-login-field">
            <label for="zdp-mobile">شماره موبایل</label>
            <input id="zdp-mobile" type="text" dir="ltr" value="09121234567" />
          </div>
          <button type="submit" class="zdp-btn">ورود با کد یک‌بارمصرف</button>
        </form>
      </section>
    </div>
  <% } else { %>
    <nav class="zdp-tabs" role="tablist" aria-label="بخش‌های پنل مراجع">
      <a href="/portal?tab=appointments" class="zdp-tab <%= activeTab === 'appointments' ? 'active' : '' %>"><span class="zdp-tab-label">نوبت‌ها</span></a>
      <a href="/portal?tab=assessments" class="zdp-tab <%= activeTab === 'assessments' ? 'active' : '' %>"><span class="zdp-tab-label">آزمون‌ها</span><% if (pendingAssessments > 0) { %><span class="zdp-tab-badge"><%= h.persianNum(pendingAssessments) %></span><% } %></a>
      <a href="/portal?tab=messages" class="zdp-tab <%= activeTab === 'messages' ? 'active' : '' %>"><span class="zdp-tab-label">پیام‌ها</span></a>
      <a href="/portal?tab=intake" class="zdp-tab <%= activeTab === 'intake' ? 'active' : '' %>"><span class="zdp-tab-label">فرم ارزیابی مراجع</span></a>
      <a href="/portal?tab=survey" class="zdp-tab <%= activeTab === 'survey' ? 'active' : '' %>"><span class="zdp-tab-label">نظرسنجی</span></a>
    </nav>

    <div class="zdp-shell-main">
      <div class="zdp-stats-grid">
        <div class="zdp-stat-card zdp-stat-card-highlight">
          <span class="zdp-stat-label">نوبت بعدی شما</span>
          <strong class="zdp-stat-value"><%= nextBooking ? nextBooking.service_name : 'ثبت نشده' %></strong>
          <span class="zdp-stat-sub"><%= nextBooking ? (h.jalali(nextBooking.booking_date) + ' — ساعت ' + h.persianNum(nextBooking.booking_time)) : '—' %></span>
          <% if (nextBooking) { %><span class="zdp-status"><%= nextBooking.status %></span><% } %>
        </div>
        <div class="zdp-stat-card">
          <span class="zdp-stat-label">آزمون‌های در انتظار</span>
          <strong class="zdp-stat-value"><%= h.persianNum(pendingAssessments) %></strong>
        </div>
        <div class="zdp-stat-card">
          <span class="zdp-stat-label">پیام‌های ثبت‌شده</span>
          <strong class="zdp-stat-value"><%= h.persianNum(messages.length) %></strong>
        </div>
      </div>

      <% if (activeTab === 'appointments') { %>
        <section class="zdp-tab-panel">
          <h2 class="zdp-portal-heading">نوبت‌های شما</h2>
          <p class="zdp-portal-lead">برای رزرو وقت جدید تاریخ، ساعت و نوع جلسه را انتخاب کنید.</p>
          <form method="post" action="/portal/book" class="zdp-booking-form">
            <div class="zdp-field">
              <label for="zdp-book-date">تاریخ (شمسی)</label>
              <div class="zdp-field-row-inline">
                <input id="zdp-book-date" type="text" name="booking_date_jalali" dir="ltr" value="<%= todayJalaliAscii %>" />
                <button type="button" class="pui-slot-pill" data-pui-fill="#zdp-book-date" data-pui-fill-val="<%= todayJalaliAscii %>">امروز</button>
              </div>
            </div>
            <div class="zdp-field">
              <label for="zdp-book-time">ساعت</label>
              <input id="zdp-book-time" type="text" name="booking_time" dir="ltr" value="16:30" />
            </div>
            <div class="zdp-field">
              <label for="zdp-book-type">نوع جلسه</label>
              <select id="zdp-book-type" name="session_type">
                <% Object.keys(sessionTypes).forEach(function(k) { %>
                  <option value="<%= k %>"><%= sessionTypes[k] %></option>
                <% }); %>
              </select>
            </div>
            <div>
              <button type="submit" class="zdp-btn">رزرو نوبت جدید</button>
            </div>
            <div class="zdp-booking-slots-row">
              <span class="zdp-booking-slots-label">ساعت‌های پرکاربرد:</span>
              <div class="pui-slot-pills">
                <button type="button" class="pui-slot-pill" data-pui-fill="#zdp-book-time" data-pui-fill-val="10:00">۱۰:۰۰</button>
                <button type="button" class="pui-slot-pill" data-pui-fill="#zdp-book-time" data-pui-fill-val="11:30">۱۱:۳۰</button>
                <button type="button" class="pui-slot-pill" data-pui-fill="#zdp-book-time" data-pui-fill-val="14:00">۱۴:۰۰</button>
                <button type="button" class="pui-slot-pill" data-pui-fill="#zdp-book-time" data-pui-fill-val="16:30">۱۶:۳۰</button>
                <button type="button" class="pui-slot-pill" data-pui-fill="#zdp-book-time" data-pui-fill-val="18:00">۱۸:۰۰</button>
              </div>
            </div>
          </form>

          <div class="zdp-portal-table-wrap">
            <table class="zdp-portal-table">
              <thead>
                <tr>
                  <th>تاریخ</th>
                  <th>خدمت</th>
                  <th>وضعیت</th>
                </tr>
              </thead>
              <tbody>
                <% bookings.forEach(function(b) { %>
                  <tr>
                    <td data-label="تاریخ" class="pui-num"><%= h.jalali(b.booking_date) %> — <%= h.persianNum(b.booking_time) %></td>
                    <td data-label="خدمت"><%= b.service_name %></td>
                    <td data-label="وضعیت"><span class="zdp-status <%= b.status === 'لغو شده' ? 'zdp-status-cancelled' : '' %>"><%= b.status %></span></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </section>
      <% } else if (activeTab === 'assessments') { %>
        <section class="zdp-tab-panel">
          <h2 class="zdp-portal-heading">آزمون‌های شما</h2>
          <% if (!invitations.length) { %>
            <p class="zdp-empty-note">آزمونی برای شما ثبت نشده است.</p>
          <% } else { %>
            <div class="zdp-portal-table-wrap">
              <table class="zdp-portal-table">
                <thead>
                  <tr>
                    <th>عنوان آزمون</th>
                    <th>وضعیت</th>
                  </tr>
                </thead>
                <tbody>
                  <% invitations.forEach(function(inv) { %>
                    <tr>
                      <td data-label="عنوان آزمون"><%= inv.quiz_name %></td>
                      <td data-label="وضعیت"><span class="zdp-status <%= inv.status === 'completed' ? 'zdp-status-انجام-شده' : 'zdp-status-pending' %>"><%= inv.status === 'completed' ? 'تکمیل شده' : 'در انتظار پاسخ' %></span></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
      <% } else if (activeTab === 'messages') { %>
        <section class="zdp-tab-panel">
          <h2 class="zdp-portal-heading">پیام‌ها با درمانگر</h2>
          <div class="zdp-chat-thread">
            <% messages.forEach(function(m) { %>
              <article class="zdp-chat-msg <%= m.sender === 'client' ? 'zdp-chat-msg--client' : 'zdp-chat-msg--therapist' %>">
                <div class="zdp-chat-msg__head">
                  <strong><%= m.sender_name %></strong>
                </div>
                <p class="zdp-chat-msg__body"><%= m.body %></p>
              </article>
            <% }); %>
          </div>
          <form method="post" action="/portal/message" class="zdp-chat-form">
            <input type="text" name="body" placeholder="پیام خود را بنویسید..." required aria-label="متن پیام" />
            <button type="submit" class="zdp-btn">ارسال پیام</button>
          </form>
        </section>
      <% } else if (activeTab === 'intake') { %>
        <section class="zdp-tab-panel">
          <h2 class="zdp-portal-heading">فرم ارزیابی مراجع</h2>
          <p class="zdp-portal-lead">اطلاعات پایهٔ شما تکمیل شده و به پروندهٔ بالینی متصل است. برای به‌روزرسانی اهداف درمان می‌توانید در جلسه با درمانگر هماهنگ کنید.</p>
        </section>
      <% } else { %>
        <section class="zdp-tab-panel">
          <h2 class="zdp-portal-heading">نظرسنجی کیفیت جلسات</h2>
          <% if (surveyDone) { %>
            <div class="pui-alert pui-alert--good">سپاسگزاریم؛ بازخورد شما ثبت شد.</div>
          <% } else { %>
            <form method="post" action="/portal/survey">
              <p class="zdp-portal-lead">میزان رضایت شما از فرآیند نوبت‌دهی و جلسهٔ مشاوره؟</p>
              <div class="zdp-survey-scale" role="radiogroup" aria-label="امتیاز رضایت">
                <% [
                  { val: 1, lbl: 'ضعیف' },
                  { val: 2, lbl: 'متوسط' },
                  { val: 3, lbl: 'خوب' },
                  { val: 4, lbl: 'بسیار خوب' },
                  { val: 5, lbl: 'عالی' }
                ].forEach(function(opt) { %>
                  <label class="zdp-survey-option">
                    <input type="radio" name="rating" value="<%= opt.val %>" <%= opt.val === 5 ? 'checked' : '' %> />
                    <span class="zdp-survey-card">
                      <span class="zdp-survey-num"><%= h.persianNum(opt.val) %></span>
                      <span class="zdp-survey-lbl"><%= opt.lbl %></span>
                    </span>
                  </label>
                <% }); %>
              </div>
              <button type="submit" class="zdp-btn">ثبت بازخورد</button>
            </form>
          <% } %>
        </section>
      <% } %>
    </div>
  <% } %>
</div>
<script src="/assets/js/ui.js"></script>
</body>
</html>

