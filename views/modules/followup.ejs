<section class="pas-card">
  <h2 class="pas-card-title">پرونده‌های نیازمند زمان‌بندی جلسهٔ بعدی</h2>
  <% if (!data.needsFollowup.length) { %>
    <p class="pas-empty">برای همهٔ پرونده‌های فعال جلسهٔ بعدی زمان‌بندی شده است.</p>
  <% } else { %>
    <div class="pui-filter-bar">
      <div class="pui-filter-bar__search">
        <input id="pvn-followup-filter" class="pas-input" type="search" placeholder="فیلتر مراجع، وضعیت یا شناسه..." data-pui-filter-target="#pvn-followup-tbody" data-pui-filter-count="#pvn-followup-count" data-pui-filter-empty="#pvn-followup-empty" aria-label="فیلتر پیگیری‌ها" />
      </div>
      <span class="pui-live-count">نمایش <strong id="pvn-followup-count"><%= h.persianNum(data.needsFollowup.length) %></strong> مورد</span>
    </div>
    <div class="pas-table-wrap">
      <table class="pas-table">
        <thead><tr><th>شناسه</th><th>مراجع</th><th>وضعیت</th><th>آخرین به‌روزرسانی</th><th>عملیات</th></tr></thead>
        <tbody id="pvn-followup-tbody">
          <% data.needsFollowup.forEach(function(c) { %>
            <tr>
              <td data-label="شناسه" class="pui-num">#<%= h.persianNum(c.id) %></td>
              <td data-label="مراجع"><%= c.full_name %></td>
              <td data-label="وضعیت"><span class="pas-badge pas-badge-warn"><%= c.status %></span></td>
              <td data-label="آخرین به‌روزرسانی" class="pui-num"><%= h.jalali(c.updated_at) %></td>
              <td data-label="عملیات"><a class="pas-btn pas-btn-sm" href="/dashboard?module=case_files&case_id=<%= c.id %>">باز کردن</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <p id="pvn-followup-empty" class="pas-empty pas-card-gap" hidden>موردی مطابق فیلتر پیدا نشد.</p>
  <% } %>
</section>

