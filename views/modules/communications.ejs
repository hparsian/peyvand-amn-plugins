<section class="pas-card">
  <h2 class="pas-card-title">کانال‌های ارتباطی</h2>
  <div class="pas-grid">
    <div class="pas-stat"><span class="pas-stat-value"><%= data.smsReady ? 'متصل' : 'پیش‌نمایش' %></span><span class="pas-stat-label">پل پیامک (MeliPayamak)</span></div>
    <div class="pas-stat"><span class="pas-stat-value"><%= data.smtpReady ? 'متصل' : 'پیش‌نمایش' %></span><span class="pas-stat-label">سرویس ایمیل (SMTP)</span></div>
  </div>
</section>

<section class="pas-card">
  <h2 class="pas-card-title">آخرین تلاش‌های ارسال پیامک</h2>
  <div class="pui-filter-bar">
    <div class="pui-filter-bar__search">
      <span class="pui-filter-bar__icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </span>
      <input class="pui-input" type="search" id="pvn-sms-filter" data-pui-filter-target="#pvn-sms-tbody" placeholder="فیلتر الگو، نتیجه یا شماره..." aria-label="فیلتر گزارش پیامک" />
    </div>
    <span class="pui-live-count" data-pui-filter-count="#pvn-sms-tbody"></span>
  </div>
  <div class="pas-table-wrap">
    <table class="pas-table">
      <thead><tr><th>زمان</th><th>شماره (ماسک‌شده)</th><th>الگو</th><th>نتیجه</th><th>توضیح</th></tr></thead>
      <tbody id="pvn-sms-tbody">
        <% data.smsLog.forEach(function(log) { %>
          <tr>
            <td data-label="زمان" class="pui-num"><%= h.jalaliDateTime(log.created_at) %></td>
            <td data-label="شماره" class="pui-num" dir="ltr"><%= h.maskMobile(log.mobile) %></td>
            <td data-label="الگو"><code><%= log.pattern %></code></td>
            <td data-label="نتیجه"><span class="pas-badge <%= log.success ? 'pas-badge-good' : 'pas-badge-danger' %>"><%= log.success ? 'موفق' : 'ناموفق' %></span></td>
            <td data-label="توضیح"><%= log.reason %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="pas-empty pas-card-gap" data-pui-filter-empty="#pvn-sms-tbody" hidden>موردی یافت نشد.</p>
</section>
