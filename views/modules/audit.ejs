<section class="pas-card">
  <h2 class="pas-card-title">رویدادهای ممیزی دسترسی</h2>
  <div class="pui-filter-bar">
    <div class="pui-filter-bar__search">
      <span class="pui-filter-bar__icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </span>
      <input class="pui-input" type="search" id="pvn-audit-filter" data-pui-filter-target="#pvn-audit-tbody" placeholder="فیلتر بر اساس رویداد، کاربر یا موجودیت..." aria-label="فیلتر گزارش ممیزی" />
    </div>
    <span class="pui-live-count" data-pui-filter-count="#pvn-audit-tbody"></span>
  </div>
  <div class="pas-table-wrap">
    <table class="pas-table">
      <thead><tr><th>زمان</th><th>رویداد</th><th>موجودیت</th><th>کاربر</th><th>نتیجه</th><th>توضیح</th></tr></thead>
      <tbody id="pvn-audit-tbody">
        <% data.entries.forEach(function(e) { %>
          <tr>
            <td data-label="زمان" class="pui-num"><%= h.jalaliDateTime(e.created_at) %></td>
            <td data-label="رویداد"><code><%= e.action %></code></td>
            <td data-label="موجودیت" class="pui-num"><%= e.entity_type %> #<%= h.persianNum(e.entity_id) %></td>
            <td data-label="کاربر"><%= e.actor %></td>
            <td data-label="نتیجه"><span class="pas-badge <%= e.status === 'ok' ? 'pas-badge-good' : 'pas-badge-danger' %>"><%= e.status %></span></td>
            <td data-label="توضیح"><%= e.detail %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="pas-empty pas-card-gap" data-pui-filter-empty="#pvn-audit-tbody" hidden>رویدادی با این فیلتر یافت نشد.</p>
</section>
