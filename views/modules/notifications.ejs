<section class="pas-card">
  <h2 class="pas-card-title">اعلان‌ها</h2>
  <% if (!data.notifications.length) { %>
    <p class="pas-empty">اعلانی ثبت نشده است.</p>
  <% } else { %>
    <ul class="pas-list">
      <% data.notifications.forEach(function(n) { %>
        <li>
          <div>
            <strong><%= n.title %></strong>
            <p class="pas-muted" style="margin:4px 0 0"><%= n.body %> — <%= h.jalaliDateTime(n.created_at) %></p>
          </div>
          <div class="pas-row-actions">
            <a class="pas-btn pas-btn-sm" href="<%= n.module_link %>">مشاهده</a>
            <% if (!n.read) { %>
              <button type="button" class="pas-btn pas-btn-sm" data-pas-read-notification="<%= n.id %>">خوانده شد</button>
            <% } else { %>
              <span class="pas-badge">خوانده‌شده</span>
            <% } %>
          </div>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>
