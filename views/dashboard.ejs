<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>پیوند امن — <%= meta.label %></title>
  <link rel="stylesheet" href="/assets/fonts/vazirmatn/vazirmatn.css">
  <link rel="stylesheet" href="/assets/fonts/plex-arabic/plex-arabic.css">
  <link rel="stylesheet" href="/assets/tokens.css">
  <link rel="stylesheet" href="/assets/components.css">
  <link rel="stylesheet" href="/assets/calm.css">
  <link rel="stylesheet" href="/assets/dashboard-admin.css">
  <link rel="stylesheet" href="/assets/shell-v2.css">
  <script>
    (function () {
      try {
        var t = localStorage.getItem('pui-theme') || 'light';
        document.documentElement.setAttribute('data-pui-theme', t === 'dark' ? 'dark' : 'light');
        document.documentElement.setAttribute('data-pui-theme-choice', t);
      } catch (e) {}
    })();
  </script>
</head>
<body>
<div class="pvn-shell pvn-shell--preview pas-dashboard" dir="rtl">
  <a class="pas-skip-link" href="#pas-main">پرش به محتوا</a>

  <div class="pvn-frame">
    <%- include('partials/header') %>

    <div class="pvn-body">
      <%- include('partials/sidebar') %>

      <main class="pvn-main pas-main" id="pas-main" tabindex="-1">
        <div class="pvn-main-inner">
          <div class="pvn-pagehead">
            <div class="pvn-pagehead__text">
              <nav class="pvn-breadcrumb" aria-label="مسیر صفحه">
                <a href="/dashboard?module=overview">داشبورد</a>
                <% if (meta.group) { %>
                  <span aria-hidden="true">/</span>
                  <span><%= meta.group %></span>
                <% } %>
                <span aria-hidden="true">/</span>
                <b aria-current="page"><%= meta.label %></b>
              </nav>
              <h1 class="pvn-pagehead__title"><%= meta.label %></h1>
              <% if (meta.description) { %>
                <p class="pvn-pagehead__sub"><%= meta.description %></p>
              <% } %>
            </div>
            <div class="pvn-pagehead__aside">
              <% if (moduleId === 'overview') { %>
                <a class="pas-btn pas-btn-primary" href="/dashboard?module=case_files&new=1">پروندهٔ جدید</a>
                <a class="pas-btn" href="/dashboard?module=appointments">نوبت‌دهی</a>
              <% } else if (moduleId === 'case_files') { %>
                <% if (data.isNew || data.selectedCase) { %>
                  <a class="pas-btn" href="/dashboard?module=case_files">بازگشت به فهرست پرونده‌ها</a>
                <% } else { %>
                  <a class="pas-btn pas-btn-primary" href="/dashboard?module=case_files&new=1">پروندهٔ جدید</a>
                <% } %>
              <% } else if (moduleId === 'appointments') { %>
                <a class="pas-btn pas-btn-primary" href="#pas-b-name">ثبت نوبت جدید</a>
              <% } else if (moduleId === 'assessments') { %>
                <% if (data.report || data.invitation) { %>
                  <a class="pas-btn" href="/dashboard?module=assessments">فهرست دعوت‌نامه‌ها</a>
                <% } else { %>
                  <a class="pas-btn pas-btn-primary" href="#pas-inv-name">ساخت دعوت‌نامه</a>
                <% } %>
              <% } else { %>
                <a class="pas-btn" href="/dashboard?module=overview">نمای کلی</a>
              <% } %>
            </div>
          </div>

          <% if (flash && flash.length) { %>
            <% flash.forEach(function(item) { %>
              <div class="pas-notice pas-notice-<%= item.type %>" role="status"><p><%= item.message %></p></div>
            <% }); %>
          <% } %>

          <%- include('modules/' + moduleId) %>
        </div>
      </main>
    </div>

    <%- include('partials/footer') %>
  </div>

  <div class="pvn-scrim" data-pvn-close-nav aria-hidden="true"></div>
</div>

<dialog class="pui-cmd-dialog" id="pvn-cmd-dialog" aria-label="پرش سریع به بخش‌های داشبورد">
  <div class="pui-cmd__head">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    </svg>
    <input type="search" id="pvn-cmd-input" class="pui-cmd__input" placeholder="جست‌وجوی ماژول یا بخش..." autocomplete="off" />
    <button type="button" class="pui-btn pui-btn--sm pui-btn--quiet" data-pui-close>Esc</button>
  </div>
  <ul class="pui-cmd__list" id="pvn-cmd-list"></ul>
  <div class="pui-cmd__foot">
    <span>حرکت با کلیدهای جهت‌دار و باز کردن با Enter</span>
    <kbd class="pui-kbd">Ctrl K</kbd>
  </div>
</dialog>

<script src="/assets/js/ui.js"></script>
<script src="/assets/js/dashboard.js"></script>
</body>
</html>
