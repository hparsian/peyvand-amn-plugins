<header class="pvn-topbar">
  <div class="pvn-topbar-start">
    <button type="button" class="pvn-burger pas-nav-toggle" aria-controls="pas-sidebar" aria-expanded="false">
      <span class="screen-reader-text">نمایش منو</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
    </button>

    <a class="pvn-brand" href="/dashboard?module=overview">
      <span class="pvn-mark" aria-hidden="true"></span>
      <span class="pvn-brand-text">
        <strong>پیوند امن</strong>
        <small>داشبورد درمانگر</small>
      </span>
    </a>

    <span class="pvn-crumb" aria-hidden="true">
      <%- h.svg(meta.id, 15) %>
      <b><%= meta.label %></b>
    </span>
  </div>

  <div class="pvn-topbar-end">
    <span class="pvn-date">امروز · <%= h.todayJalali %></span>

    <a class="pas-btn pas-btn-sm" href="/portal" title="مشاهدهٔ پنل مراجع">پنل مراجع</a>

    <button type="button" class="pvn-icon-btn pvn-theme-toggle" data-pui-theme-toggle aria-pressed="false" title="تغییر حالت روشن/تاریک">
      <svg class="pvn-theme-toggle__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z"/>
      </svg>
      <svg class="pvn-theme-toggle__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"/>
      </svg>
      <span class="screen-reader-text">تغییر حالت رنگ</span>
    </button>

    <a class="pvn-icon-btn pvn-bell" href="/dashboard?module=notifications" title="اعلان‌ها">
      <%- h.svg('notifications', 18) %>
      <% if (unread > 0) { %>
        <span class="pvn-bell__count"><%= h.persianNum(unread) %></span>
      <% } %>
      <span class="screen-reader-text"><%= h.persianNum(unread) %> اعلان خوانده‌نشده</span>
    </a>

    <span class="pvn-user">
      <span class="pvn-avatar" aria-hidden="true"><%= user.initial %></span>
      <span class="pvn-user__name"><%= user.name %></span>
    </span>
  </div>
</header>
